<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PMEquipment.MainPage"
             Title="نرم‌افزار جامع PM تجهیزات">
    <Grid RowDefinitions="Auto,*" Padding="0">
        <Grid Grid.Row="0" BackgroundColor="#17365D" Padding="8" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                <Label Text="نرم‌افزار جامع نگهداری و تعمیرات (PM)" TextColor="White" FontAttributes="Bold" />
                <Label Text="نسخه ۴٫۰ | آفلاین | تعداد نامحدود تجهیزات" TextColor="#DCE8F5" FontSize="11" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="بارگذاری مجدد" Clicked="OnReloadClicked"
                    BackgroundColor="#315A87" TextColor="White" FontSize="12" />
        </Grid>
        <WebView x:Name="AppWebView" Grid.Row="1" />
    </Grid>
</ContentPage>
